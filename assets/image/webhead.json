{
  "name": "Roost Demo",
  "hostname": "roost",
  "prompt": "roost# ",
  "ssid": "Roost",
  "domain": "roost.local",
  "dnsAnswer": "127.0.0.1",
  "extendedShell": false,
  "services": {
    "http":      { "enabled": true, "addr": ":8080" },
    "https":     { "enabled": true, "addr": ":8443", "certDir": "certs" },
    "dns":       { "enabled": true, "addr": ":5354" },
    "ssh":       { "enabled": true, "addr": ":2222", "user": "roost", "pass": "roost" },
    "dashboard": { "enabled": true, "addr": ":9090" }
  }
}
